# =============================================================================
# EL SCORE OS — Environment Variables Reference
# Copy relevant variables to apps/api/.env and apps/web/.env.local
# Never commit actual .env files to version control.
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://elscore:secret@localhost:5432/elscore_os_dev

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=change-this-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# --- App ---
NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
