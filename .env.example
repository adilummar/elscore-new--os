# =============================================================================
# EL SCORE OS — Environment Variables Reference
# Copy relevant variables to apps/api/.env and apps/web/.env.local
# Never commit actual .env files to version control.
# =============================================================================

# --- Database (PostgreSQL) ---
# The Prisma schema does not pin a server version. Local Docker Compose and CI
# use PostgreSQL 16. At least one migration calls gen_random_uuid().
# Transaction advisory locks need the transaction's database session to stay pinned.
DATABASE_URL=postgresql://elscore:secret@localhost:5432/elscore_os_dev

# --- Redis ---
# BullMQ prefix is elscore-<APP_ENV, otherwise NODE_ENV>. A refused Redis
# connection does not stop API boot. The health payload reports it; HTTP status stays 200.
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional. Omit when Redis has no password. An empty value is passed through.
REDIS_PASSWORD=

# --- JWT ---
# Startup requires both secrets to be non-empty. Length is not enforced.
# Use high-entropy values in any shared environment. These examples are not secrets to reuse.
JWT_ACCESS_SECRET=change-this-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# --- App ---
NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
# Comma-separated browser origins. The API does not trim spaces around entries.
CORS_ORIGINS=http://localhost:3000
# Business date-boundary timezone. Unset defaults to Asia/Kolkata in the API.
# SYSTEM_TIMEZONE=Asia/Kolkata

# Local filesystem root for onboarding document binaries (API process).
# The directory does not have to exist first; the API creates it when permitted.
# The API user must be able to create and write this path. The application does
# not set a permission mode. This storage is local disk only. Multiple API
# replicas need the same shared filesystem mounted at this absolute path,
# because saved documents record that absolute path.
# Unset defaults to <API process cwd>/storage/private/onboarding.
# ONBOARDING_STORAGE_DIR=

# --- Web ---
# Deployment-specific URLs. Do not put secrets, tokens, or credentials in them.
# These two values may differ when the browser and the Next.js server reach the
# API through different hosts. Include the API prefix (default /api/v1).

# Browser-facing API base URL. Next.js inlines NEXT_PUBLIC_* values present at build.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Internal API base URL used by Next.js server code (server components, middleware
# refresh, and server route proxies). Not read by browser code.
# Outside development, server components and document proxies fail closed when this
# is empty. A non-empty value present at `next build` is inlined via
# apps/web/next.config.mjs and is not replaced by a later process environment.
API_URL=http://localhost:3001/api/v1

# Auth cookies are HttpOnly, SameSite=Lax, and Secure unless this is the exact
# string false. Use false only for plain HTTP. HTTPS should use true or leave
# this unset. The application does not detect HTTPS by itself.
COOKIE_SECURE=true
