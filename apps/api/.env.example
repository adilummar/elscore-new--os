# =============================================================================
# EL SCORE OS — API Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.
# =============================================================================

NODE_ENV=development

# ─── Server ──────────────────────────────────────────────────────────────────
API_PORT=3001
API_PREFIX=api/v1
# Comma-separated browser origins. Entries are not trimmed.
CORS_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The schema does not pin a server version. Local Docker Compose and CI use
# PostgreSQL 16. A migration calls gen_random_uuid(). Transaction advisory locks
# require the transaction's database session to stay pinned.
DATABASE_URL=postgresql://elscore:secret@localhost:5432/elscore_os_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
# BullMQ connects at API startup. A refused connection is swallowed; the process
# can still boot. GET /api/v1/health reports redis "down" and status "error",
# and still returns HTTP 200. Queue key prefix is elscore-<APP_ENV or NODE_ENV>.
# NODE_ENV itself only accepts development, test, or production.
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional. An empty value is passed through; omit the variable when Redis has no password.
# REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Use strong random secrets in production (32+ chars recommended).
# Startup requires both values to be non-empty. It does not enforce length or entropy.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Throttling ───────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ─── Business timezone ────────────────────────────────────────────────────────
# Used for date-boundary logic. Unset defaults to Asia/Kolkata.
# SYSTEM_TIMEZONE=Asia/Kolkata

# ─── Onboarding document storage ──────────────────────────────────────────────
# Local filesystem root for private onboarding binaries. Not object storage.
# The directory does not have to exist beforehand; the API creates it when the
# process can write the path. No permission mode is forced by the application.
# The process user needs create/write access. Reads require read access.
# Multiple API replicas must share this exact absolute path. Saved rows store
# the absolute file path, so a different mount path on another replica will not
# find the file. Unset defaults to <process cwd>/storage/private/onboarding.
# Do not put secrets in this value.
# ONBOARDING_STORAGE_DIR=
