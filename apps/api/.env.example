# =============================================================================
# EL SCORE OS — API Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.
# =============================================================================

NODE_ENV=development

# ─── Server ──────────────────────────────────────────────────────────────────
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://elscore:secret@localhost:5432/elscore_os_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=                    # Leave blank for local dev without auth

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Use strong random secrets in production (32+ chars each).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Throttling ───────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
