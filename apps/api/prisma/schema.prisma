model StudentAttendance {
  id         String @id @default(uuid())
  businessId String @unique @map("business_id")

  sessionId String @map("session_id")

  studentId       String  @map("student_id")
  tutorClassRecId String? @map("tutor_class_record_id")

  status      StudentAttendanceStatus
  actualStart DateTime?               @map("actual_start")
  actualEnd   DateTime?               @map("actual_end")

  markedByUserId String   @map("marked_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  isCorrected       Boolean   @default(false) @map("is_corrected")
  correctionReason  String?   @map("correction_reason")
  correctedByUserId String?   @map("corrected_by_user_id")
  correctedAt       DateTime? @map("corrected_at")

  student          Student           @relation(fields: [studentId], references: [id])
  tutorClassRecord TutorClassRecord? @relation(fields: [tutorClassRecId], references: [id])

  @@unique([sessionId, studentId])
  @@map("student_attendances")
}

model TutorClassRecord {
  id         String @id @default(uuid())
  businessId String @unique @map("business_id")

  sessionId String @map("session_id")
  tutorId   String @map("tutor_id")

  status       TutorClassRecordStatus    @default(DRAFT)
  cancellation SessionCancellationReason @default(NOT_CANCELLED)

  scheduledStart DateTime  @map("scheduled_start")
  scheduledEnd   DateTime  @map("scheduled_end")
  actualStart    DateTime? @map("actual_start")
  actualEnd      DateTime? @map("actual_end")
  workedMinutes  Int?      @map("worked_minutes")

  appliedRate Decimal? @map("applied_rate") @db.Decimal(10, 2)
  currency    String?
  rateGrade   String?  @map("rate_grade")
  rateSubject String?  @map("rate_subject")

  submittedAt      DateTime? @map("submitted_at")
  verifiedAt       DateTime? @map("verified_at")
  verifiedByUserId String?   @map("verified_by_user_id")

  isPayrollReady Boolean @default(false) @map("is_payroll_ready")

  isCorrected      Boolean @default(false) @map("is_corrected")
  correctionReason String? @map("correction_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tutor              User                @relation("TutorClassRecords", fields: [tutorId], references: [id])
  studentAttendances StudentAttendance[]

  @@unique([sessionId, tutorId])
  @@map("tutor_class_records")
}

model MarketingAttribution {
  id                 String   @id @default(uuid())
  leadId             String   @unique @map("lead_id")
  channel            String?
  campaign           String?
  externalCampaignId String?  @map("external_campaign_id")
  externalLeadId     String?  @map("external_lead_id")
  acquiredAt         DateTime @default(now()) @map("acquired_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("marketing_attributions")
}

model IntegrationCredential {
  id         String   @id @default(uuid())
  provider   String   @unique
  apiKeyHash String   @map("api_key_hash")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("integration_credentials")
}

model MarketingInteraction {
  id             String   @id @default(uuid())
  leadId         String   @map("lead_id")
  provider       String
  externalLeadId String   @map("external_lead_id")
  campaignId     String?  @map("campaign_id")
  campaignName   String?  @map("campaign_name")
  adsetId        String?  @map("adset_id")
  adsetName      String?  @map("adset_name")
  adId           String?  @map("ad_id")
  adName         String?  @map("ad_name")
  isOriginal     Boolean  @default(false) @map("is_original")
  receivedAt     DateTime @default(now()) @map("received_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([provider, externalLeadId])
  @@index([leadId])
  @@map("marketing_interactions")
}

enum SalesTargetType {
  CONVERSION_PERCENTAGE
  REVENUE_AED
}

/// Current active target per counsellor per calendar month (one row).
/// Mid-month changes do NOT overwrite — they create a SalesTargetHistory record.
model SalesTarget {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  periodMonth Int             @map("period_month")
  periodYear  Int             @map("period_year")
  targetType  SalesTargetType @map("target_type")
  targetValue Decimal         @map("target_value") @db.Decimal(10, 2)
  setByUserId String          @map("set_by_user_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user    User                 @relation("UserSalesTarget", fields: [userId], references: [id])
  setBy   User                 @relation("UserSetSalesTarget", fields: [setByUserId], references: [id])
  history SalesTargetHistory[]

  @@unique([userId, periodYear, periodMonth])
  @@map("sales_targets")
}

/// Immutable audit trail: every time a SalesTarget is changed, the PREVIOUS
/// configuration is snapshotted here before the update is applied.
model SalesTargetHistory {
  id              String          @id @default(uuid())
  salesTargetId   String          @map("sales_target_id")
  userId          String          @map("user_id") // counsellor affected
  periodMonth     Int             @map("period_month")
  periodYear      Int             @map("period_year")
  previousType    SalesTargetType @map("previous_type")
  previousValue   Decimal         @map("previous_value") @db.Decimal(10, 2)
  newType         SalesTargetType @map("new_type")
  newValue        Decimal         @map("new_value") @db.Decimal(10, 2)
  changedByUserId String          @map("changed_by_user_id")
  changedAt       DateTime        @default(now()) @map("changed_at")

  salesTarget SalesTarget @relation(fields: [salesTargetId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("SalesTargetHistoryChangedBy", fields: [changedByUserId], references: [id])

  @@index([salesTargetId, changedAt])
  @@index([userId, periodYear, periodMonth])
  @@map("sales_target_history")
}

