// ATTENDANCE & WORK-TIME (Slice 2G)
// ============================================================================

model GlobalWorkingSchedule {
  id            String   @id @default(uuid())
  startTime     String // e.g., "09:00"
  endTime       String // e.g., "18:00"
  timezone      String   @default("Asia/Kolkata")
  effectiveFrom DateTime @default(now()) @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by")

  @@index([effectiveFrom(sort: Desc)])
  @@map("global_working_schedules")
}

enum AttendanceSessionStatus {
  ACTIVE
  ON_BREAK
  COMPLETED
  AUTO_CHECKED_OUT
}

model EmployeeAttendanceSession {
  id               String                  @id @default(uuid())
  employeeId       String                  @map("employee_id")
  calendarDate     String                  @map("calendar_date") // "YYYY-MM-DD" in Asia/Kolkata
  scheduleSnapshot Json                    @map("schedule_snapshot") // { startTime, endTime, timezone, scheduleId }
  status           AttendanceSessionStatus
  isLate           Boolean                 @default(false) @map("is_late")
  lateMinutes      Int                     @default(0) @map("late_minutes")

  grossDurationMinutes Int @default(0) @map("gross_duration_minutes")
  breakDurationMinutes Int @default(0) @map("break_duration_minutes")
  netDurationMinutes   Int @default(0) @map("net_duration_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee    Employee                       @relation(fields: [employeeId], references: [id])
  events      EmployeeAttendanceEvent[]
  corrections EmployeeAttendanceCorrection[]

  @@index([employeeId, calendarDate])
  @@index([status])
  @@map("employee_attendance_sessions")
}

enum AttendanceEventType {
  CHECK_IN
  BREAK_START
  BREAK_END
  CHECK_OUT
  AUTO_CHECK_OUT
  AUTO_BREAK_END
}

model EmployeeAttendanceEvent {
  id        String              @id @default(uuid())
  sessionId String              @map("session_id")
  eventType AttendanceEventType @map("event_type")
  timestamp DateTime // Authoritative server timestamp (exact time action occurred or effective end-of-day)

  isInvalidated Boolean @default(false) @map("is_invalidated")

  createdAt DateTime @default(now()) @map("created_at")

  session EmployeeAttendanceSession @relation(fields: [sessionId], references: [id])

  // Relations to corrections
  correctionsAsOriginal EmployeeAttendanceCorrection[] @relation("OriginalEvent")
  correctionsAsNew      EmployeeAttendanceCorrection[] @relation("NewEvent")

  @@index([sessionId])
  @@index([timestamp])
  @@map("employee_attendance_events")
}

model EmployeeAttendanceCorrection {
  id                String   @id @default(uuid())
  sessionId         String   @map("session_id")
  originalEventId   String   @map("original_event_id")
  newEventId        String   @map("new_event_id")
  reason            String
  correctedByUserId String   @map("corrected_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  session         EmployeeAttendanceSession @relation(fields: [sessionId], references: [id])
  originalEvent   EmployeeAttendanceEvent   @relation("OriginalEvent", fields: [originalEventId], references: [id])
  newEvent        EmployeeAttendanceEvent   @relation("NewEvent", fields: [newEventId], references: [id])
  correctedByUser User                      @relation(fields: [correctedByUserId], references: [id])

  @@index([sessionId])
  @@map("employee_attendance_corrections")
}
