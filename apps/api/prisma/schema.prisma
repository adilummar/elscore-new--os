// M-010 - CRM FOUNDATION (SLICE 2A)
// =============================================================================

enum RoundRobinDailyState {
  ACTIVE
  INACTIVE_FROM_NOW
  INACTIVE_FULL_DAY
}

enum LeadAssignmentType {
  AUTOMATIC_ROUND_ROBIN
  MANUAL_SALES_HEAD
  COUNSELLOR_SELF_CREATED
  REFERRAL
  REASSIGNMENT
  REOPENED
}

enum LeadSource {
  META_FACEBOOK
  INSTAGRAM
  GOOGLE
  WEBSITE
  REFERRAL
  DIRECT
  OTHER
}

enum LeadCreationChannel {
  INTEGRATION
  SALES_HEAD
  SALES_COUNSELLOR
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  DEMO_BOOKED
  DEMO_COMPLETED
  NEGOTIATION
  NURTURE
  ENROLLED
  PAID
  NOT_INTERESTED
  NO_RESPONSE
  LOST
  JUNK
}

enum EnrollmentState {
  PENDING
  ENROLLED
  NOT_ENROLLING
}

model Lead {
  id                    String                 @id @default(uuid())
  businessId            String                 @unique @map("business_id")
  firstName             String?                @map("first_name")
  lastName              String?                @map("last_name")
  primaryPhone          String                 @map("primary_phone")
  altPhone1             String?                @map("alt_phone_1")
  altPhone2             String?                @map("alt_phone_2")
  whatsappNumber        String?                @map("whatsapp_number")
  source                LeadSource
  creationChannel       LeadCreationChannel    @map("creation_channel")
  status                LeadStatus             @default(NEW)
  currentClassification ContactClassification? @map("current_classification")
  requiresFollowUp      Boolean                @default(false) @map("requires_follow_up")
  assignedToUserId      String?                @map("assigned_to_user_id")
  createdByUserId       String                 @map("created_by_user_id")
  isArchived            Boolean                @default(false) @map("is_archived")
  archivedAt            DateTime?              @map("archived_at")
  archivedByUserId      String?                @map("archived_by_user_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  assignedToUser User? @relation("AssignedLeads", fields: [assignedToUserId], references: [id])
  createdByUser  User  @relation("CreatedLeads", fields: [createdByUserId], references: [id])
  archivedByUser User? @relation("ArchivedLeads", fields: [archivedByUserId], references: [id])

  students              Student[]
  statusHistory         LeadStatusHistory[]
  assignmentHistory     LeadAssignmentHistory[]
  salesNotes            SalesNote[]
  followUps             FollowUp[]
  targetCreditLedger    TargetCreditLedger[]
  invoices              Invoice[]
  marketingAttribution  MarketingAttribution?
  marketingInteractions MarketingInteraction[]

  @@index([assignedToUserId])
  @@index([primaryPhone])
  @@index([status])
  @@index([currentClassification])
  @@index([isArchived])
  @@index([createdAt])
  @@map("leads")
}

model Student {
  id              String          @id @default(uuid())
  businessId      String          @unique @map("business_id")
  leadId          String          @map("lead_id")
  firstName       String          @map("first_name")
  lastName        String?         @map("last_name")
  dateOfBirth     DateTime?       @map("date_of_birth")
  gender          String?
  schoolName      String?         @map("school_name")
  currentGrade    String?         @map("current_grade")
  cityLocation    String?         @map("city_location")
  notes           String?         @db.Text
  enrollmentState EnrollmentState @default(PENDING) @map("enrollment_state")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  lead               Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  requirements       Requirement[]
  demos              Demo[]
  invoices           Invoice[]
  targetCreditLedger TargetCreditLedger[]
  StudentAttendance  StudentAttendance[]

  @@index([leadId])
  @@map("students")
}

model Requirement {
  id           String   @id @default(uuid())
  businessId   String   @unique @map("business_id")
  studentId    String   @map("student_id")
  subjectId    String   @map("subject_id")
  curriculumId String   @map("curriculum_id")
  gradeId      String   @map("grade_id")
  syllabus     String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  grade      Grade      @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  demos      Demo[]

  @@index([studentId])
  @@map("requirements")
}

model LeadStatusHistory {
  id              String      @id @default(uuid())
  leadId          String      @map("lead_id")
  oldStatus       LeadStatus? @map("old_status")
  newStatus       LeadStatus  @map("new_status")
  reason          String
  note            String?     @db.Text
  changedByUserId String      @map("changed_by_user_id")
  changedAt       DateTime    @default(now()) @map("changed_at")

  lead          Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedByUser User @relation("LeadStatusChanges", fields: [changedByUserId], references: [id])

  @@index([leadId, changedAt])
  @@map("lead_status_history")
}

model LeadAssignmentHistory {
  id               String             @id @default(uuid())
  leadId           String             @map("lead_id")
  oldOwnerUserId   String?            @map("old_owner_user_id")
  newOwnerUserId   String?            @map("new_owner_user_id")
  reason           String?
  assignmentType   LeadAssignmentType @default(MANUAL_SALES_HEAD) @map("assignment_type")
  assignedByUserId String             @map("assigned_by_user_id")
  assignedAt       DateTime           @default(now()) @map("assigned_at")

  lead           Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldOwner       User? @relation("OldLeadAssignments", fields: [oldOwnerUserId], references: [id])
  newOwner       User? @relation("NewLeadAssignments", fields: [newOwnerUserId], references: [id])
  assignedByUser User  @relation("LeadAssignmentsMade", fields: [assignedByUserId], references: [id])

  @@index([leadId, assignedAt])
  @@map("lead_assignment_history")
}

model SalesNote {
  id              String   @id @default(uuid())
  leadId          String   @map("lead_id")
  content         String   @db.Text
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  lead          Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdByUser User @relation("CreatedSalesNotes", fields: [createdByUserId], references: [id])

  @@index([leadId])
  @@map("sales_notes")
}

// =============================================================================
// M-007 — CRM FOLLOW-UPS (Slice 2B)
// =============================================================================

enum ContactClassification {
  QUALIFIED
  NON_QUALIFIED
  NO_RESPONSE
  JUNK
}

enum FollowUpStatus {
  SCHEDULED
  OVERDUE
  COMPLETED
}

/// A single contact attempt/action against a Lead by a Sales Counsellor.
/// Each actual contact = new FollowUp record. Do NOT reuse a record across contacts.
/// Business ID format: FUP-NNNN (generated by IdGeneratorService in transaction).
model FollowUp {
  id                String                 @id @default(uuid())
  businessId        String                 @unique @map("business_id")
  leadId            String                 @map("lead_id")
  createdByUserId   String                 @map("created_by_user_id")
  scheduledAt       DateTime               @map("scheduled_at")
  classification    ContactClassification? @map("classification")
  status            FollowUpStatus         @default(SCHEDULED) @map("status")
  completedAt       DateTime?              @map("completed_at")
  completedByUserId String?                @map("completed_by_user_id")
  remarks           String?                @db.Text
  reminderJobId     String?                @map("reminder_job_id")
  overdueJobId      String?                @map("overdue_job_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  lead              Lead                        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  createdByUser     User                        @relation("CreatedFollowUps", fields: [createdByUserId], references: [id])
  completedByUser   User?                       @relation("CompletedFollowUps", fields: [completedByUserId], references: [id])
  rescheduleHistory FollowUpRescheduleHistory[]

  @@index([leadId, status])
  @@index([scheduledAt, status])
  @@index([createdByUserId, status])
  @@map("follow_ups")
}

/// Immutable reschedule log for a FollowUp.
/// Rescheduling mutates the parent FollowUp.scheduledAt;
/// this table preserves the full trail of previous schedules.
model FollowUpRescheduleHistory {
  id                  String   @id @default(uuid())
  followUpId          String   @map("follow_up_id")
  previousScheduledAt DateTime @map("previous_scheduled_at")
  newScheduledAt      DateTime @map("new_scheduled_at")
  reason              String?  @db.Text
  rescheduledByUserId String   @map("rescheduled_by_user_id")
  rescheduledAt       DateTime @default(now()) @map("rescheduled_at")

  followUp          FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  rescheduledByUser User     @relation("RescheduledFollowUps", fields: [rescheduledByUserId], references: [id])

  @@index([followUpId])
  @@map("follow_up_reschedule_history")
}

model RoundRobinState {
  id                 String   @id @default("singleton")
  isPaused           Boolean  @default(false) @map("is_paused")
  lastAssignedUserId String?  @map("last_assigned_user_id")
  updatedAt          DateTime @updatedAt @map("updated_at")

  lastAssignedUser User? @relation(fields: [lastAssignedUserId], references: [id])

  @@map("round_robin_state")
}

model RoundRobinCounsellorState {
  userId         String               @id @map("user_id")
  isEligible     Boolean              @default(true) @map("is_eligible")
  dailyState     RoundRobinDailyState @default(ACTIVE) @map("daily_state")
  lastReturnedAt DateTime?            @map("last_returned_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("round_robin_counsellor_state")
}

// =============================================================================
// M-008 — DEMO (Slice 2D)
// =============================================================================

enum DemoStatus {
  SCHEDULED
  ASSIGNED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model Demo {
  id              String     @id @default(uuid())
  businessId      String     @unique @map("business_id")
  studentId       String     @map("student_id")
  requirementId   String     @map("requirement_id")
  tutorId         String?    @map("tutor_id")
  status          DemoStatus @default(SCHEDULED)
  scheduledAt     DateTime   @map("scheduled_at")
  durationMinutes Int        @map("duration_minutes")

  // Academic Snapshot
  subjectId    String @map("subject_id")
  curriculumId String @map("curriculum_id")
  gradeId      String @map("grade_id")

  bookedByUserId String    @map("booked_by_user_id")
  cancelledAt    DateTime? @map("cancelled_at")
  cancelReason   String?   @map("cancel_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  student      Student     @relation(fields: [studentId], references: [id])
  requirement  Requirement @relation(fields: [requirementId], references: [id])
  tutor        User?       @relation("AssignedDemos", fields: [tutorId], references: [id])
  subject      Subject     @relation(fields: [subjectId], references: [id])
  curriculum   Curriculum  @relation(fields: [curriculumId], references: [id])
  grade        Grade       @relation(fields: [gradeId], references: [id])
  bookedByUser User        @relation("BookedDemos", fields: [bookedByUserId], references: [id])

  feedback          DemoFeedback?
  rescheduleHistory DemoRescheduleHistory[]

  @@index([studentId])
  @@index([tutorId, scheduledAt])
  @@index([status])
  @@map("demos")
}

model DemoRescheduleHistory {
  id                  String   @id @default(uuid())
  demoId              String   @map("demo_id")
  previousScheduledAt DateTime @map("previous_scheduled_at")
  newScheduledAt      DateTime @map("new_scheduled_at")
  reason              String   @db.Text
  rescheduledByUserId String   @map("rescheduled_by_user_id")
  rescheduledAt       DateTime @default(now()) @map("rescheduled_at")

  demo              Demo @relation(fields: [demoId], references: [id], onDelete: Cascade)
  rescheduledByUser User @relation("RescheduledDemos", fields: [rescheduledByUserId], references: [id])

  @@index([demoId])
  @@map("demo_reschedule_history")
}

model DemoFeedback {
  id                String   @id @default(uuid())
  demoId            String   @unique @map("demo_id")
  rating            Int
  comments          String   @db.Text
  submittedByUserId String   @map("submitted_by_user_id")
  submittedAt       DateTime @default(now()) @map("submitted_at")

  demo            Demo @relation(fields: [demoId], references: [id], onDelete: Cascade)
  submittedByUser User @relation("DemoFeedbackGiven", fields: [submittedByUserId], references: [id])

  @@map("demo_feedback")
}

// =============================================================================
// M-009 — FINANCE (Slice 2E)
// =============================================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERPAID
  VOIDED
}

enum InvoiceLineItemType {
  REGISTRATION_FEE
  TUITION
  OTHER
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
}

enum PaymentStatus {
  SUCCESS
  REVERSED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  EXECUTED
}

model Invoice {
  id             String        @id @default(uuid())
  businessId     String        @unique @map("business_id")
  studentId      String        @map("student_id")
  leadId         String?       @map("lead_id")
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @default(0) @db.Decimal(10, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(10, 2)
  outstanding    Decimal       @default(0) @db.Decimal(10, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  issuedAt  DateTime? @map("issued_at")
  voidedAt  DateTime? @map("voided_at")
  createdBy String    @map("created_by")
  issuedBy  String?   @map("issued_by")

  student Student @relation(fields: [studentId], references: [id])
  lead    Lead?   @relation(fields: [leadId], references: [id])
  creator User    @relation("InvoiceCreator", fields: [createdBy], references: [id])
  issuer  User?   @relation("InvoiceIssuer", fields: [issuedBy], references: [id])

  lineItems    InvoiceLineItem[]
  installments Installment[]
  payments     Payment[]

  @@map("invoices")
}

model InvoiceLineItem {
  id          String              @id @default(uuid())
  invoiceId   String              @map("invoice_id")
  type        InvoiceLineItemType
  description String
  quantity    Int                 @default(1)
  unitAmount  Decimal             @map("unit_amount") @db.Decimal(10, 2)
  totalAmount Decimal             @map("total_amount") @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

model Installment {
  id         String            @id @default(uuid())
  invoiceId  String            @map("invoice_id")
  sequence   Int
  amount     Decimal           @db.Decimal(10, 2)
  dueDate    DateTime          @map("due_date")
  status     InstallmentStatus @default(PENDING)
  amountPaid Decimal           @default(0) @map("amount_paid") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("installments")
}

model Payment {
  id             String        @id @default(uuid())
  businessId     String        @unique @map("business_id")
  invoiceId      String        @map("invoice_id")
  idempotencyKey String        @unique @map("idempotency_key")
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CASH) @map("payment_method")
  receivedAt     DateTime      @map("received_at")
  recordedBy     String        @map("recorded_by")
  note           String?       @db.Text
  status         PaymentStatus @default(SUCCESS)
  reversalReason String?       @map("reversal_reason") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")

  invoice  Invoice @relation(fields: [invoiceId], references: [id])
  recorder User    @relation("PaymentRecorder", fields: [recordedBy], references: [id])

  receipt Receipt?
  refunds Refund[]

  @@map("payments")
}

model Receipt {
  id          String   @id @default(uuid())
  businessId  String   @unique @map("business_id")
  paymentId   String?  @unique @map("payment_id")
  refundId    String?  @unique @map("refund_id")
  amount      Decimal  @db.Decimal(10, 2)
  generatedAt DateTime @default(now()) @map("generated_at")
  isValid     Boolean  @default(true) @map("is_valid")

  payment Payment? @relation(fields: [paymentId], references: [id])
  refund  Refund?  @relation(fields: [refundId], references: [id])

  @@map("receipts")
}

model Refund {
  id        String       @id @default(uuid())
  paymentId String       @map("payment_id")
  amount    Decimal      @db.Decimal(10, 2)
  reason    String       @db.Text
  status    RefundStatus @default(REQUESTED)

  requestedBy String  @map("requested_by")
  approvedBy  String? @map("approved_by")
  executedBy  String? @map("executed_by")

  requestedAt DateTime  @default(now()) @map("requested_at")
  approvedAt  DateTime? @map("approved_at")
  executedAt  DateTime? @map("executed_at")

  payment   Payment @relation(fields: [paymentId], references: [id])
  requester User    @relation("RefundRequester", fields: [requestedBy], references: [id])
  approver  User?   @relation("RefundApprover", fields: [approvedBy], references: [id])
  executor  User?   @relation("RefundExecutor", fields: [executedBy], references: [id])

  receipt Receipt?

  @@map("refunds")
}

model TargetCreditLedger {
  id           String  @id @default(uuid())
  salesOwnerId String  @map("sales_owner_id")
  leadId       String  @map("lead_id")
  studentId    String  @map("student_id")
  invoiceId    String  @map("invoice_id")
  paymentId    String? @map("payment_id")
  refundId     String? @map("refund_id")

  amount          Decimal  @db.Decimal(10, 2)
  transactionType String   @map("transaction_type") // 'PAYMENT', 'REFUND'
  timestamp       DateTime @default(now())

  salesOwner User    @relation("SalesTargetCredit", fields: [salesOwnerId], references: [id])
  lead       Lead    @relation(fields: [leadId], references: [id])
  student    Student @relation(fields: [studentId], references: [id])

  @@unique([paymentId, transactionType], name: "unique_payment_credit")
  @@unique([refundId, transactionType], name: "unique_refund_credit")
  @@map("target_credit_ledger")
}

