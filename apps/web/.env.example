# EL SCORE OS — Web App Environment Variables
# Copy to .env.local for development.
# These values are deployment-specific URLs. Do not put secrets, tokens, or
# credentials in them. API_URL and NEXT_PUBLIC_API_URL may differ when the
# browser and the Next.js server reach the API through different hosts.

# Browser-facing API base URL.
# Next.js inlines NEXT_PUBLIC_* values that are present at `next build`.
# Include the API prefix (default /api/v1). Callers append a path such as /auth/login.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Internal API base URL used by Next.js server code: server components,
# middleware token refresh, and server route proxies. Browser code does not read it.
# Outside development, server components and document proxies fail closed when this is empty.
# apps/web/next.config.mjs publishes API_URL through Next's env config. A non-empty
# value present at `next build` is inlined into the bundle; a later process
# environment does not replace that inlined value. Include the API prefix.
API_URL=http://localhost:3001/api/v1

# Auth cookies are HttpOnly, SameSite=Lax, and Secure unless this is the exact
# string false. Use false only for plain HTTP. HTTPS should use true or leave
# this unset. The application does not detect HTTPS by itself.
COOKIE_SECURE=true
