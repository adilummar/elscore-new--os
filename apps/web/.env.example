# EL SCORE OS — Web App Environment Variables
# Copy to .env.local for development.

# Public API URL (called from the browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Server-side API URL (called from Next.js server components/routes)
API_URL=http://localhost:3001/api/v1

# Secure auth cookies by default. Set false only for plain-HTTP staging.
# Production HTTPS should use true or leave this unset.
COOKIE_SECURE=true
